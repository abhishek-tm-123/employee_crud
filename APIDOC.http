#api call fo listing employees
###
GET http://127.0.0.1:8000/employees/
Accept: application/json


# api call for creating new employee
###
POST http://127.0.0.1:8000/employees/
Content-Type: application/json

{
    "name":"hari",
    "email":"hari@gmail.com",
    "phone":"234567890",
    "salary":55000,
    "department":"hr",
    "location":"kakkanad"
}

#api call for retrieve a employee
###
GET http://127.0.0.1:8000/employees/1/
Accept: application/json

#api call for updating a employee
###
PUT http://127.0.0.1:8000/employees/1/
Content-Type: application/json

{
    "id": 1,
    "name": "hari",
    "email": "hari@gmail.com",
    "phone": "234567890",
    "salary": "70000.00",
    "department": "hr",
    "location": "thrissur"
  }

#api call for deleting a employee
###
DELETE http://127.0.0.1:8000/employees/1/
Accept: application/json